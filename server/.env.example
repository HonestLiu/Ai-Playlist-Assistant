# ---------------------------------------------------------------------------
# 复制为 .env 后填写。所有配置均通过 app.core.config.Settings 统一读取，
# 业务代码不允许直接使用 os.environ。
# 嵌套配置使用双下划线分隔：SECTION__FIELD
# ---------------------------------------------------------------------------

APP_NAME=AI Playlist Assistant
DEBUG=true

# --- HTTP 服务 -------------------------------------------------------------
SERVER__HOST=127.0.0.1
SERVER__PORT=8000
SERVER__LOG_LEVEL=INFO
# 逗号分隔，前端 dev server 地址
SERVER__CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Subsonic 音乐服务器 ----------------------------------------------------
SUBSONIC__URL=https://music.example.com
SUBSONIC__USERNAME=your-username
SUBSONIC__PASSWORD=your-password
# 客户端标识，会出现在 Navidrome 的活动记录里
SUBSONIC__CLIENT_NAME=ai-playlist
SUBSONIC__API_VERSION=1.16.1
# true = 明文/enc 密码（老服务器），false = salt+token（推荐）
SUBSONIC__LEGACY_AUTH=false
SUBSONIC__TIMEOUT=15
SUBSONIC__VERIFY_SSL=true

# --- LLM（Phase 3 使用，此处先占位）------------------------------------------
LLM__PROVIDER=openai
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=
LLM__MODEL=gpt-4o-mini
LLM__TEMPERATURE=0.7
